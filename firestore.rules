rules_version = '2';

// Your whole app state — products, orders, customers, costs, suppliers — lives in
// the single document app/state. It is written ONLY by the server using the Admin
// SDK, which bypasses these rules entirely.
//
// So the correct rule for browsers is: deny everything. If this were left open,
// anyone could read your customer list, purchase prices and margins straight from
// the browser, or wipe the document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
