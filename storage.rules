rules_version = '2';

// Product photos and net diagrams must be publicly readable (the storefront shows
// them), but only the server may upload. The server uses the Admin SDK, which
// bypasses these rules — so browsers get read-only access and nothing more.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{file=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
